{
  "name": "AURORA — Lecteur de musique génératif",
  "short_name": "AURORA",
  "description": "Lecteur de musique local hors-ligne avec un visuel WebGL unique généré pour chaque piste.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#050508",
  "theme_color": "#050508",
  "lang": "fr",
  "dir": "ltr",
  "categories": ["music", "entertainment"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Reprendre la lecture",
      "short_name": "Reprendre",
      "description": "Reprendre la dernière piste écoutée",
      "url": "/?action=resume",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Rechercher",
      "short_name": "Rechercher",
      "description": "Rechercher dans la bibliothèque et en ligne",
      "url": "/?action=search",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Lecture aléatoire",
      "short_name": "Aléatoire",
      "description": "Lancer toute la bibliothèque en aléatoire",
      "url": "/?action=shuffle",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
