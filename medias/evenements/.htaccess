# ==========================================================================
# SÉCURITÉ DU DOSSIER DES MÉDIAS D'ÉVÉNEMENTS (photos et vidéos PUBLIQUES)
# Les fichiers sont déposés depuis le back-office (admin/evenement-modifier.php)
# sous un nom aléatoire. Ici :
#   - pas de liste des fichiers du dossier ;
#   - aucun script ne peut être exécuté (même si un fichier .php arrivait ici) ;
#   - le navigateur ne "devine" pas le type des fichiers (nosniff).
# Pas de php_flag (provoque une erreur 500 sur les hébergements PHP-FPM).
# ==========================================================================
Options -Indexes

<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|shtml|asp|aspx|jsp|htaccess)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# ANTI-TÉLÉCHARGEMENT DIRECT : une photo ou une vidéo n'est envoyée que si elle
# est demandée par une page de CE site (en-tête Referer = même nom de domaine).
# Adresse tapée directement, "ouvrir dans un nouvel onglet", affichage depuis un
# autre site : accès refusé (403). (Le motif \1 vérifie que le domaine du
# Referer est identique au domaine du site.)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST}@@%{HTTP_REFERER} !^([^@]+)@@https?://\1(:\d+)?/ [NC]
    RewriteRule \.(jpe?g|png|webp|mp4|webm)$ - [F,NC]
</IfModule>
